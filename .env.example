# Environment variables required by the application will be documented here.
# Copy this file to .env when local secrets or environment-specific
# configuration are introduced.
#
# Never place real API keys or passwords in this file.

POSTGRES_DB=portfolio_ai
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=1234
DATABASE_URL=postgresql+psycopg://portfolio:1234@localhost:5432/portfolio_ai
DATABASE_URL_DOCKER=postgresql+psycopg://portfolio:1234@db:5432/portfolio_ai

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

LLM_MODEL=gpt-5.6-terra
LLM_MAX_OUTPUT_TOKENS=800

CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60